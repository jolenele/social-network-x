# Firebase Admin service account JSON as a single escaped JSON string OR set GOOGLE_APPLICATION_CREDENTIALS to the file path
# Option 1 (preferred): point GOOGLE_APPLICATION_CREDENTIALS at a service account JSON file
# Option 2: fill FIREBASE_SERVICE_ACCOUNT_JSON with the JSON string (escaped newlines)
GOOGLE_APPLICATION_CREDENTIALS="/Users/vane/Downloads/stone-poetry-478121-q4-70ff7922339b.json"

# Firebase storage bucket name (e.g. my-project.appspot.com)
FIREBASE_STORAGE_BUCKET="my-new-me"

# Firestore project id
FIREBASE_PROJECT_ID="stone-poetry-478121"

# Local server port
PORT=3001
